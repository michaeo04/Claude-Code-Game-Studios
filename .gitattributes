# Normalize line endings: LF in the repository and in working copies
# (Godot, shell hooks and skills expect LF; avoids CRLF churn on Windows).
* text=auto eol=lf

*.sh text eol=lf
*.bat text eol=crlf

# Binary assets (never diffed or normalized)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.glb binary
*.fbx binary
*.blend binary
*.ttf binary
*.otf binary
