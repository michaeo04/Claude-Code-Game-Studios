   "scope": [
    "src/**/*hazard*.gd",
    "src/**/*obstacle*.gd",
    "src/**/*near_miss*.gd",
    "src/**/*pattern*.gd"
   ],
   "pattern": "\\.duplicate(?:_deep)?\\s*\\(",
