  {
   "id": "forbidden:pause_resume_as_pause_signal",
   "source": "ADR-0006",
   "severity": "BLOCKING",
   "kind": "forbid",
   "scope": [
    "src/**/*.gd"
   ],
   "pattern": "\\bNOTIFICATION_APPLICATION_(?:PAUSED|RESUMED)\\b",
