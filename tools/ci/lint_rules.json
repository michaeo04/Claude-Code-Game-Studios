{
 "version": 1,
 "comment": "ADR-0009 Decision 5 rule table. Silence a rule only through allow/exclude, never an inline comment. Fixtures: tools/ci/tests/fixtures/<safe_id>/{pass,fail}.txt (first line '#@path: <virtual path>').",
 "review_only": [
  {
   "pattern": "unique_mesh_or_material_per_tube_slot",
   "reason": "needs scene-graph reasoning; covered by the tube render integration test"
  },
  {
   "pattern": "set_value_per_drag_event",
   "reason": "signal wiring between value_changed and set_value; covered by Settings UI review and test"
  },
  {
   "pattern": "apply_map_with_side_effects",
   "reason": "behavioural (no signal, no generation); covered by unit tests of apply_map"
  },
  {
   "pattern": "mutate_cached_map_resource",
   "reason": "write-through-reference semantics; covered by unit tests and code review"
  },
  {
   "pattern": "spacing_history_without_spikes",
   "reason": "algorithmic property of the sequencer; covered by golden sequence tests"
  },
  {
   "pattern": "trust_godot_exit_code",
   "reason": "enforced by the mandatory result checks in tools/ci/run_ci.py"
  },
  {
   "pattern": "hazard_node_per_piece",
   "reason": "scene structure; covered by the hazard render draw-call integration test"
  },
  {
   "pattern": "hazard_mesh_winding_untested",
   "reason": "test-existence requirement; covered by the HazardMeshBuilder winding test (ADR-0014)"
  },
  {
   "pattern": "ink_cover_cleared_by_run_reset",
   "reason": "behavioural; covered by the InkCoverCore unit test"
  }
 ],
 "rules": [
  {
   "id": "forbidden:view_node_own_process",
   "source": "ADR-0002",
   "severity": "BLOCKING",
   "kind": "only_in",
   "scope": [
    "src/**/*.gd"
   ],
   "pattern": "\\bfunc\\s+_(?:physics_)?process\\b",
   "allow": [
    "src/**/game_root.gd"
   ],
   "message": "_process/_physics_process only in game_root.gd; GameRoot calls views and drivers"
  },
  {
   "id": "forbidden:connect_deferred_control_signals",
   "source": "ADR-0002",
   "severity": "BLOCKING",
   "kind": "forbid",
   "scope": [
    "src/**/*.gd"
   ],
   "pattern": "\\bCONNECT_DEFERRED\\b",
   "message": "Control signals must not use CONNECT_DEFERRED"
  },
  {
   "id": "forbidden:connect_deferred_control_signals_scene",
   "source": "ADR-0002",
   "severity": "BLOCKING",
   "kind": "custom",
   "function": "tscn_connection_deferred",
   "scope": [
    "**/*.tscn"
   ],
   "signal_pattern": "^(run_\\w+|hit_reported|window_\\w+)$",
   "message": "Scene [connection] on a control signal carries the deferred flag"
  },
  {
   "id": "forbidden:engine_time_scale_writes",
   "source": "ADR-0002",
   "severity": "BLOCKING",
   "kind": "forbid",
   "scope": [
    "src/**/*.gd"
   ],
   "pattern": "\\bEngine\\.time_scale\\s*[-+*/]?=(?!=)",
   "message": "No code writes Engine.time_scale"
  },
  {
   "id": "forbidden:scene_tree_paused_for_pause",
   "source": "ADR-0002",
   "severity": "BLOCKING",
   "kind": "forbid",
   "scope": [
    "src/**/*.gd"
   ],
   "pattern": "\\.paused\\s*=(?!=)",
   "message": "Freeze the world through dt_eff = 0, never SceneTree.paused"
  },
  {
   "id": "forbidden:physics_process_game_logic",
   "source": "ADR-0002",
   "severity": "BLOCKING",
   "kind": "forbid",
   "scope": [
    "src/**/*.gd"
   ],
   "pattern": "\\bfunc\\s+_physics_process\\b",
   "message": "No game logic in _physics_process"
  },
  {
   "id": "lint:typed_method_references",
   "source": "ADR-0002",
   "severity": "BLOCKING",
   "kind": "forbid",
   "scope": [
    "src/**/game_root.gd"
   ],
   "pattern": "\\bCallable\\s*\\([^()\\n]*,\\s*\\\"\\\"\\s*\\)|\\.connect\\s*\\(\\s*\\\"\\\"",
   "message": "Typed method references at the composition root: no string-built Callable, no string connect"
  },
  {
   "id": "forbidden:engine_glow_for_gameplay_effects",
   "source": "ADR-0003",
   "severity": "BLOCKING",
   "kind": "forbid",
   "scope": [
    "src/**/*.gd",
    "src/**/*.tscn",
    "src/**/*.tres",
    "assets/**/*.tscn",
    "assets/**/*.tres"
   ],
   "pattern": "\\bglow_enabled\\s*=\\s*true",
   "message": "WorldEnvironment glow stays off in the MVP"
  },
  {
   "id": "forbidden:realtime_shadows",
   "source": "ADR-0003",
   "severity": "BLOCKING",
   "kind": "forbid",
   "scope": [
    "src/**/*.gd",
    "src/**/*.tscn",
    "src/**/*.tres",
    "assets/**/*.tscn",
    "assets/**/*.tres"
   ],
   "pattern": "\\bshadow_enabled\\s*=\\s*true",
   "message": "No light casts shadows"
  },
  {
   "id": "forbidden:compositor_effects_mvp",
   "source": "ADR-0003",
   "severity": "BLOCKING",
   "kind": "forbid",
   "scope": [
    "src/**/*.gd",
    "src/**/*.tscn",
    "src/**/*.tres",
    "assets/**/*.tscn",
    "assets/**/*.tres"
   ],
   "pattern": "\\bCompositor(?:Effect)?\\b",
   "message": "No Compositor / CompositorEffect in the MVP"
  },
  {
   "id": "forbidden:map_content_file_io",
   "source": "ADR-0004",
   "severity": "BLOCKING",
   "kind": "only_in",
   "scope": [
    "src/**/*.gd"
   ],
   "pattern": "\\bResourceLoader\\b|\\b(?:FileAccess|DirAccess)\\s*\\.\\s*\\w+\\s*\\(\\s*\\\"res://",
   "allow": [
    "src/**/map_loader.gd"
   ],
   "keep_strings": true,
   "message": "res:// content is loaded only through ResourceLoader in map_loader.gd, never FileAccess/DirAccess"
  },
  {
   "id": "forbidden:non_scalar_tube_config_field",
   "source": "ADR-0004",
   "severity": "BLOCKING",
   "kind": "forbid",
   "scope": [
    "src/**/*tube_config*.gd",
    "src/**/*env_config*.gd"
   ],
   "pattern": "\\bvar\\s+\\w+\\s*(?::\\s*(?:Array|Dictionary|Resource|Packed\\w*Array|MapDefinition|MapConfig)\\b|=\\s*[\\[{])",
   "message": "TubeConfig and EnvConfig hold only scalars, enums and Colors"
  },
  {
   "id": "forbidden:sensor_reads_outside_tilt_input",
   "source": "ADR-0005",
   "severity": "BLOCKING",
   "kind": "only_in",
   "scope": [
    "src/**/*.gd"
   ],
   "pattern": "\\bInput\\.(?:get_gravity|get_accelerometer|get_gyroscope|get_magnetometer)\\s*\\(",
